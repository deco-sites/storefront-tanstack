{
  "name": "storefront-tanstack",
  "account_id": "c95fc4cec7fc52453228d9db170c372c",
  "compatibility_date": "2026-02-14",
  "compatibility_flags": [
    "nodejs_compat",
    "no_handle_cross_request_promise_resolution"
  ],
  "main": "./src/worker-entry.ts",
  "workers_dev": true,
  "preview_urls": true,
  // Workers Cache — tiered cache IN FRONT of the worker. On a hit the worker
  // does not run at all (0 invocation, 0 CPU). Config-as-code: the dashboard
  // toggle is per-version and gets reset on every deploy, so it must live here
  // to survive. Cacheability is still driven per-response by Cache-Control /
  // CDN-Cache-Control (the site defaults to no-store; only /cache-probe opts in).
  "cache": { "enabled": true },
  // Strategy B tail worker — 100% capture of producer errors that the
  // framework's direct-POST channel can't see (uncaught throws, exceededCpu,
  // exceededMemory, raw console.error). Invoked by CF on every request to
  // this worker; filters and forwards to deco-otel-ingest via in-account
  // service binding. See the observability block below for the full
  // three-channel model.
  "tail_consumers": [
    { "service": "deco-otel-tail" }
  ],
  // Worker version (build SHA / deployment id) — sent as `service.version` with the
  // CMS's telemetry (src/cms.ts).
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // SITES_KV: the A/B split against a legacy origin (src/worker-entry.ts, abTestingRoutes).
  // v7's DECO_KV (fast deploy) is gone: content is hosted on the delivery CDN.
  "kv_namespaces": [
    {
      "binding": "SITES_KV",
      "id": "ad0b74fc4d9341c9af9149c4ab85132f"
    }
  ],
  // Telemetry: the CMS's own (src/cms.ts). With the DECO_SITE_TOKEN secret it goes to the hosted
  // collector; else, with the DECO_OTEL_AUTH_TOKEN secret, to v7's OTLP collector
  // (otel-ingest.infra.deco.cx); else nowhere. The tail worker above still catches uncaught errors.
  "vars": {
    "DECO_SITE_NAME": "storefront-tanstack",
    "DECO_ENV_NAME": "production",
    // The hosted CMS site the content is read from (src/cms.ts): its latest release on
    // delivery.decocms.com. SPIKE: the spike's own site, published under spikes/ (README, "Spike").
    "DECO_SITE": "cas-sites-storefront-tanstack"
    // DECO_SITE_TOKEN goes as a secret: wrangler secret put DECO_SITE_TOKEN
  }
}
